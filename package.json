{
  "name": "opencode-multi-repo-vcs",
  "version": "1.0.1",
  "description": "Aggregate uncommitted changes from nested Git repositories into OpenCode's review panel",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vcs",
    "git",
    "monorepo",
    "nested-repositories"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --external:@opencode/plugin --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.2"
  }
}
